<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <CurlImpersonateWindowsNativePath>$(MSBuildThisFileDirectory)..\runtimes\win-x64\native\</CurlImpersonateWindowsNativePath>
    <CurlImpersonateLinuxNativePath>$(MSBuildThisFileDirectory)..\runtimes\linux-x64\native\</CurlImpersonateLinuxNativePath>
  </PropertyGroup>

  <!-- Windows natives -->
  <ItemGroup Condition="Exists('$(CurlImpersonateWindowsNativePath)')">
    <None Include="$(CurlImpersonateWindowsNativePath)**\*.*">
      <Link>runtimes\win-x64\native\%(RecursiveDir)%(FileName)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Linux natives -->
  <ItemGroup Condition="Exists('$(CurlImpersonateLinuxNativePath)')">
    <None Include="$(CurlImpersonateLinuxNativePath)**\*.*">
      <Link>runtimes\linux-x64\native\%(RecursiveDir)%(FileName)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyCurlImpersonateNatives" AfterTargets="Build">
    <!-- Copy Windows natives -->
    <ItemGroup Condition="Exists('$(CurlImpersonateWindowsNativePath)')">
      <CurlImpersonateWindowsFiles Include="$(CurlImpersonateWindowsNativePath)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(CurlImpersonateWindowsFiles)"
          DestinationFolder="$(OutputPath)runtimes\win-x64\native\"
          SkipUnchangedFiles="true"
          Condition="Exists('$(CurlImpersonateWindowsNativePath)')" />

    <!-- Copy Linux natives -->
    <ItemGroup Condition="Exists('$(CurlImpersonateLinuxNativePath)')">
      <CurlImpersonateLinuxFiles Include="$(CurlImpersonateLinuxNativePath)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(CurlImpersonateLinuxFiles)"
          DestinationFolder="$(OutputPath)runtimes\linux-x64\native\"
          SkipUnchangedFiles="true"
          Condition="Exists('$(CurlImpersonateLinuxNativePath)')" />
  </Target>

</Project>
