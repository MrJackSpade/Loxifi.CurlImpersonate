<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <CurlImpersonateNativePath>$(MSBuildThisFileDirectory)..\runtimes\win-x64\native\</CurlImpersonateNativePath>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(CurlImpersonateNativePath)')">
    <None Include="$(CurlImpersonateNativePath)**\*.*">
      <Link>runtimes\win-x64\native\%(RecursiveDir)%(FileName)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyCurlImpersonateNatives" AfterTargets="Build" Condition="Exists('$(CurlImpersonateNativePath)')">
    <ItemGroup>
      <CurlImpersonateFiles Include="$(CurlImpersonateNativePath)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(CurlImpersonateFiles)"
          DestinationFolder="$(OutputPath)runtimes\win-x64\native\"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
