<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Loxifi.CurlImpersonate\Loxifi.CurlImpersonate.csproj" />
  </ItemGroup>

  <!-- Copy native curl files to output - Windows -->
  <ItemGroup>
    <None Include="..\..\runtimes\win-x64\native\libcurl-impersonate.dll" CopyToOutputDirectory="PreserveNewest" Link="runtimes\win-x64\native\libcurl-impersonate.dll" />
    <None Include="..\..\runtimes\win-x64\native\zlib.dll" CopyToOutputDirectory="PreserveNewest" Link="runtimes\win-x64\native\zlib.dll" />
    <None Include="..\..\runtimes\win-x64\native\cacert.pem" CopyToOutputDirectory="PreserveNewest" Link="runtimes\win-x64\native\cacert.pem" />
  </ItemGroup>

  <!-- Copy native curl files to output - Linux (if built) -->
  <ItemGroup Condition="Exists('..\..\runtimes\linux-x64\native\libcurl-impersonate.so')">
    <None Include="..\..\runtimes\linux-x64\native\libcurl-impersonate.so" CopyToOutputDirectory="PreserveNewest" Link="runtimes\linux-x64\native\libcurl-impersonate.so" />
    <None Include="..\..\runtimes\linux-x64\native\cacert.pem" CopyToOutputDirectory="PreserveNewest" Link="runtimes\linux-x64\native\cacert.pem" Condition="Exists('..\..\runtimes\linux-x64\native\cacert.pem')" />
  </ItemGroup>

</Project>